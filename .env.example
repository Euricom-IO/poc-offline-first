# Shared configuration for the API and the db package.
# Copy to `.env`. Bun only loads a `.env` from the process cwd, and the package
# scripts run from their own directory, so each one passes --env-file=../../.env
# to pick this file up — see "`.env` and the package scripts" in CLAUDE.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todoapp
JWT_SECRET=dev-secret-change-me
API_PORT=3000
# Consumed by the web dev server / vite proxy target
VITE_API_URL=http://localhost:3000
# PowerSync service endpoint handed to the browser client (web-powersync).
# Routed through the fault-injection proxy so the download stream can be broken
# on demand; point both at http://localhost:8080 to talk to the service directly.
VITE_POWERSYNC_URL=http://localhost:3100/powersync
# Server-side endpoint returned by GET /api/powersync/token — this one wins.
POWERSYNC_URL=http://localhost:3100/powersync
# Fault-injection dev proxy (packages/proxy) that sits between web-powersync and the API
PROXY_PORT=3100
# Control plane, on its own port so it survives POST /down
PROXY_CONTROL_PORT=3101
PROXY_TARGET=http://localhost:3000
# Second upstream: requests to /powersync/* are forwarded here, prefix stripped
POWERSYNC_TARGET=http://localhost:8080
# Dev-server proxy target for web-powersync; set to http://localhost:3000 to bypass the proxy
VITE_PROXY_URL=http://localhost:3100
